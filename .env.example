# Neon connection strings (never commit the real .env file)
# Pooled string (host contains "-pooler") used by the running app:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) string used by Prisma migrations.
# If unsure, paste the same string in both variables.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: currency code shown in the UI (default USD), e.g. GHS
NEXT_PUBLIC_CURRENCY="USD"
