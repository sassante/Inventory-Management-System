generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum MovementType {
  IN
  OUT
  ADJUST
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id           Int             @id @default(autoincrement())
  sku          String          @unique
  name         String
  categoryId   Int
  category     Category        @relation(fields: [categoryId], references: [id])
  price        Decimal         @db.Decimal(10, 2)
  quantity     Int             @default(0)
  reorderLevel Int             @default(10)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]

  @@index([categoryId])
  @@index([name])
}

// `quantity` is a SIGNED change: IN = +n, OUT = -n, ADJUST = (counted - previous).
// Invariant: product.quantity == SUM(movement.quantity) for that product.
model StockMovement {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MovementType
  quantity  Int
  note      String?
  createdBy String?
  createdAt DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}
